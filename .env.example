# Azure
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_KEYVAULT_URL=https://kv-calibration-dev-001.vault.azure.net/

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calibration_db

# Service Bus (local dev: use Redis)
SERVICEBUS_CONNECTION_STRING=
SERVICEBUS_QUEUE_NAME=calibration-measurements
USE_REDIS_QUEUE=true
REDIS_URL=redis://localhost:6379

# App
APP_ENV=dev
APP_SECRET_KEY=dev-secret-key-change-in-prod
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Auth (dev mode bypass)
DEV_MODE=true

# Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_RAW=raw-measurements
AZURE_STORAGE_CONTAINER_REPORTS=reports

# Anomaly Detection
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MODEL_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
